{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "tenon",
  "description": "Tenon Workbench desktop and agent runtime",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --cwd packages/tenon --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:web": "bun --cwd packages/app dev",
    "lint": "oxlint",
    "format:check": "prettier --check packages --ignore-path .gitignore --ignore-path .prettierignore --ignore-path packages/app/.gitignore --ignore-path packages/desktop/.gitignore --ignore-path packages/sdk/.gitignore --ignore-path packages/tenon/.gitignore",
    "typecheck": "bun turbo typecheck",
    "prepare": "cd .. && husky tenon/.husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.1.2",
      "@effect/platform-node": "4.1.2",
      "@effect/sql-sqlite-bun": "4.1.2",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@tanstack/solid-virtual": "3.13.32",
      "@shikijs/stream": "4.2.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@corvu/drawer": "0.2.4",
      "@types/node": "24.12.2",
      "@tsconfig/node24": "24.0.5",
      "@tsconfig/bun": "1.0.9",
      "@pierre/diffs": "1.2.10",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.5",
      "drizzle-orm": "1.0.0-rc.5",
      "effect": "4.1.2",
      "ai": "6.0.323",
      "cross-spawn": "7.0.6",
      "fuzzysort": "3.1.0",
      "marked": "18.0.7",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "@playwright/test": "1.59.1",
      "typescript": "5.9.3",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "zod": "4.6.7",
      "remeda": "2.26.0",
      "shiki": "4.2.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "vite": "7.3.7",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "solid-js": "1.9.18",
      "solid-sonner": "0.3.1",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ToRRIIDeR97/Tenon-Workbench"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "endOfLine": "auto"
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "pacote": "21.5.3",
    "tar": "7.5.22",
    "ws": "8.22.1"
  },
  "patchedDependencies": {
    "@dnd-kit/dom@0.5.3": "patches/@dnd-kit%2Fdom@0.5.3.patch",
    "@ff-labs/fff-bun@0.9.4": "patches/@ff-labs%2Ffff-bun@0.9.4.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "solid-js@1.9.18": "patches/solid-js@1.9.18.patch",
    "@ai-sdk/xai@3.0.149": "patches/@ai-sdk%2Fxai@3.0.149.patch",
    "@ai-sdk/mistral@3.0.79": "patches/@ai-sdk%2Fmistral@3.0.79.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.3": "patches/pacote@21.5.3.patch",
    "@ai-sdk/google@3.0.141": "patches/@ai-sdk%2Fgoogle@3.0.141.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.32.2": "patches/@modelcontextprotocol%2Fsdk@1.32.2.patch",
    "effect@4.1.2": "patches/effect@4.1.2.patch",
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch",
    "@ai-sdk/groq@3.0.81": "patches/@ai-sdk%2Fgroq@3.0.81.patch",
    "bun-pty@0.4.8": "patches/bun-pty@0.4.8.patch"
  }
}
