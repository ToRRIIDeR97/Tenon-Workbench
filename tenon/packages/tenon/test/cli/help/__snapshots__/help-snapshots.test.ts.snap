// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`tenon CLI help-text snapshots every documented command emits stable help text: tenon mcp --help 1`] = `
"tenon mcp

manage MCP (Model Context Protocol) servers

Commands:
  tenon mcp add [name]     add an MCP server
  tenon mcp list           list MCP servers and their status                           [aliases: ls]
  tenon mcp auth [name]    authenticate with an OAuth-enabled MCP server
  tenon mcp logout [name]  remove OAuth credentials for an MCP server
  tenon mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`tenon CLI help-text snapshots every documented command emits stable help text: tenon debug --help 1`] = `
"tenon debug

debugging and troubleshooting tools

Commands:
  tenon debug config        show resolved configuration
  tenon debug lsp           LSP debugging utilities
  tenon debug rg            ripgrep debugging utilities
  tenon debug file          file system debugging utilities
  tenon debug scrap         list all known projects
  tenon debug skill         list all available skills
  tenon debug snapshot      snapshot debugging utilities
  tenon debug startup       print startup timing
  tenon debug agent <name>  show agent configuration details
  tenon debug v2            debug v2 catalog and built-in plugins
  tenon debug info          show debug information
  tenon debug paths         show global paths (data, config, cache, state)
  tenon debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

