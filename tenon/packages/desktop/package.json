{
  "name": "@tenon/desktop",
  "private": true,
  "description": "Files, notes, projects, planning, and agent workflows",
  "version": "1.18.21",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ToRRIIDeR97/Tenon-Workbench",
  "author": {
    "name": "ToRRIIDeR97",
    "email": "ToRRIIDeR97@users.noreply.github.com"
  },
  "scripts": {
    "test": "bun test --only-failures && node --experimental-strip-types --test src/main/draft-store.node-test.ts",
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "build:dictation": "cargo build --release --manifest-path ../dictation/Cargo.toml"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron-context-menu": "5.1.0",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.12",
    "electron-window-state": "^5.0.3",
    "imapflow": "1.7.8"
  },
  "devDependencies": {
    "@lydell/node-pty": "catalog:",
    "@tenon/app": "workspace:*",
    "@tenon/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
